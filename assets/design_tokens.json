    "color-error": "#f28b82",
    "color-info-bg": "#12303a",
    "color-info-fg": "#7fd1e8",
    "color-shadow": "#00000066"
  },
  "typography": {
    "font-base": {
      "family": "Inter",
      "fallback": [
        "system-ui",
        "-apple-system",
        "sans-serif"
      ]
    },
    "font-mono": {
      "family": "Fira Code",
      "fallback": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "layout": {
    "width-max": 1100,
    "border-radius": 8,
    "shadow-card": "none"
  },
  "mobile": {
    "touch-target-min": 44,
    "breakpoint-sm": 576,
    "breakpoint-md": 768,
    "breakpoint-lg": 992,
    "breakpoint-xl": 1200
  },
  "fonts": {
    "Inter-Regular": {
      "family": "Inter",
      "weight": 400,
      "file": "Inter-Regular.woff2",
      "style": "normal"
    },
    "Inter-SemiBold": {
      "family": "Inter",
      "weight": 600,
      "file": "Inter-SemiBold.woff2",
      "style": "normal"
    },
    "Inter-Bold": {
      "family": "Inter",
      "weight": 700,
      "file": "Inter-Bold.woff2",
      "style": "normal"
    },
    "Poppins-SemiBold": {
      "family": "Poppins",
      "weight": 600,
      "file": "Poppins-SemiBold.woff2",
      "style": "normal"
    }
  },
  "typeScale": {
    "display": {
      "size": 32,
      "weight": 700,
      "lineHeight": 1.2
    },
    "h1": {
      "size": 24,
      "weight": 600,
      "lineHeight": 1.3
    },
    "h2": {
      "size": 20,
      "weight": 600,
      "lineHeight": 1.3
    },
    "h3": {
      "size": 16,
      "weight": 600,
      "lineHeight": 1.4
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.5
    },
    "small": {
      "size": 12,
      "weight": 400,
      "lineHeight": 1.5
    }
  }
