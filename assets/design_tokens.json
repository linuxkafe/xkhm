    "color-on-header": "#f0f0f0",
    "color-border": "#333333",
    "color-link": "#66b2ff",
    "color-logo-plate": "#ffffff"
  },
  "semantic": {
    "color-success-bg": "#d4edda",
    "color-success-fg": "#155724",
    "color-on-success": "#ffffff",
    "color-warning-bg": "#fff3cd",
    "color-warning-fg": "#856404",
    "color-danger-bg": "#f8d7da",
    "color-danger-fg": "#721c24",
    "color-neutral-bg": "#e9ecef",
    "color-neutral-fg": "#383d41",
    "color-error": "#dc3545",
    "color-info-bg": "#d1ecf1",
    "color-info-fg": "#0c5460",
    "color-shadow": "#0000001a"
  },
  "darkSemantic": {
    "color-success-bg": "#16351f",
    "color-success-fg": "#7ee2a8",
    "color-on-success": "#16351f",
    "color-warning-bg": "#3a2f10",
    "color-warning-fg": "#f0c674",
    "color-danger-bg": "#3d1a1a",
    "color-danger-fg": "#f28b82",
    "color-neutral-bg": "#2a2a2a",
