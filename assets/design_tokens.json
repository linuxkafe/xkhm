{
  "$comment": "Canonical LINUXKAFE design tokens. This file is the SINGLE SOURCE OF TRUTH for the colour scheme shared by the PHP/CSS front-end and the Flutter application. Run `make tokens` to regenerate the CSS and Dart outputs. Keys are the CSS custom-property names from the source theme, so the mapping to the Dart constants is unambiguous. The `darkColors` and `darkSemantic` sections hold the same keys as their light counterparts: the palette is a function of the mode.",
  "source": {
    "url": "http://www.linuxkafe.com/wp-content/themes/linuxkafe/style.css",
    "theme": "linuxkafe",
    "version": "2.1.0"
  },
  "colors": {
