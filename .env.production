# Xkhm WHMCS Reimplementation
# Production Configuration — TEMPLATE
#
# This file holds the **shape** of the configuration, never the values.
# A secret in a versioned file is a secret in the git history; that is
# how the production database password ended up published on the
# internet (see aes/tickets/T027.md and aes/tickets/T032.md).
#
# The real file lives outside the repository, on the server, with mode
# 0600. Copy this template there and fill it in.

# App Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Database
#
# DB_PASSWORD is the **production** password. It must be rotated — the
# previous one was published on 0.0.0.0:3306 and is in the git history.
# The tool that does it, and verifies it:
#
#   python3 tools/rotate_db_password.py --host <host> --user linuxkonect --apply
DB_HOST=mysql
DB_PORT=3306
DB_NAME=linuxkonect
DB_USER=linuxkonect
DB_PASSWORD=

# The WHMCS encryption hash. It is a **shared** secret: the application
# and the WHMCS must agree on it, or the encrypted data in the database
# becomes unreadable. It cannot simply be rotated — that needs a
# migration of the encrypted data.
CC_ENCRYPTION_HASH=

# The credential-recovery tokens. The delivery is pluggable:
#
#   XKHM_SMTP_HOST — the SMTP server. **Not** set means the token is
#   written to a file and delivered by the host's mailer.
#   XKHM_SMTP_PORT — the port (25 is the local, unauthenticated Postfix).
#   XKHM_SMTP_USER / XKHM_SMTP_PASS — the credentials, when the server
#   asks for them. Leave them empty for the local Postfix.
#   XKHM_SMTP_FROM — the sender. The local relay only accepts the
#   address it is authorised for.
XKHM_SMTP_HOST=
XKHM_SMTP_PORT=25
XKHM_SMTP_USER=
XKHM_SMTP_PASS=
XKHM_SMTP_FROM=

# The credential-recovery tokens, as delivered by the **host's** mailer
# (tools/mail_pending_tokens.py). The application writes the queue; the
# host delivers it — the application usually cannot reach the mail
# server from inside a container.
#
# XKHM_MAILER_SMTP_HOST / XKHM_MAILER_SMTP_PORT — the mail server.
# XKHM_MAILER_SMTP_FROM — the sender. The relay only accepts the
#   address it is authorised for.
# XKHM_MAILER_ALLOW_RESERVED — deliver to the reserved test domains
#   (example.com, localhost, …). Off by default: those domains do not
#   exist, and mail sent to them comes back as a bounce.
XKHM_MAILER_SMTP_HOST=127.0.0.1
XKHM_MAILER_SMTP_PORT=25
XKHM_MAILER_SMTP_FROM=
XKHM_MAILER_ALLOW_RESERVED=

# Session
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# Redis (optional)
REDIS_HOST=redis
REDIS_PORT=6379
